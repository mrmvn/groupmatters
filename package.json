{
  "name": "groupmatters",
  "version": "0.1.0",
  "description": "Keep track of your group's matters, and link them to where they're worked on.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "cli": "node src/cli.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "linkedom": "^0.18.14",
    "typescript": "^5.9.3"
  }
}
