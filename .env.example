# Copy to .env (git-ignored) and adjust. Load with:
#   npm start / npm run dev                 (read .env automatically if it exists)
#   node --env-file=.env src/main.ts
#   docker run --env-file .env ...
PUBLIC_URL=https://groupmatters.org
# Shown as "Source" in the page footer. Operators of a modified version should point to their own source (AGPL §13).
SOURCE_URL=https://github.com/mrmvn/groupmatters
# Shown as "Contact" in the footer (a mailto link). Leave out to hide the link.
CONTACT_EMAIL=
# Shown on the privacy page under "Hosting", e.g.:
# HOSTING=This server runs on a virtual private server (VPS) from DigitalOcean in London, United Kingdom.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# METACULUS_TOKEN=
